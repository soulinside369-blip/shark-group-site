# Shark Group — sharkgroup.pro (хостинг Reg.ru, Apache)
# Один адрес сайта: https://sharkgroup.pro (www и http перенаправляются сюда)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.sharkgroup\.pro$ [NC]
RewriteRule ^ https://sharkgroup.pro%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://sharkgroup.pro%{REQUEST_URI} [L,R=301]

# Однофайловая версия и служебное — не отдаём
<FilesMatch "^(shark-group\.html|HANDOFF\.md|README\.md)$">
  Require all denied
</FilesMatch>

# Кэш: картинки (имя меняется через ?h=хэш) — надолго, страница — без кэша
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
