# Shark Group — секреты сайта. Этот файл кладётся НЕ в папку сайта, а рядом с ней:
#   /var/www/u3723546/data/sg-private/sg.env      (папка сайта: /var/www/u3723546/data/www/sharkgroup.pro)
# Заполняет владелец. В репозиторий настоящие значения не попадают.

# Telegram-бот: токен из @BotFather (вид 1234567890:AA...)
TG_BOT_TOKEN=
# Куда слать заявки: id чата или группы. Несколько — через запятую.
# Как узнать: добавьте бота в чат, напишите в чат любое сообщение и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — число в "chat":{"id": ...}
TG_CHAT_ID=

# Пароль входа в https://sharkgroup.pro/admin/ — не короче 10 символов
ADMIN_PASSWORD=
